{
  "$schema": "../App/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Digivice",
  "version": "../App/package.json",
  "identifier": "com.digivice.app",
  "build": {
    "frontendDist": "../App/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../App"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../App"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Digivice",
        "width": 800,
        "height": 600,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
